module PrettyExpressive.Json exposing (docToJson)

{-| Serialize a `Doc` tree to a compact JSON string for debugging or interop.

@docs docToJson
-}

import Json.Encode as Json
import PrettyExpressive as P


{-| Convert a `Doc cost` to a compact JSON string.

Each `Doc` variant is encoded as a JSON object with a `"type"` field:

  - `DocFail`       → `{"type":"fail"}`
  - `DocText`       → `{"type":"text","string":"...","width":N}`
  - `DocNewline`    → `{"type":"newline","flatForm":"..."}` or `{"type":"newline","flatForm":null}`
  - `DocConcat`     → `{"type":"concat","a":{...},"b":{...}}`
  - `DocChoice`     → `{"type":"choice","a":{...},"b":{...}}`
  - `DocNest`       → `{"type":"nest","indent":N,"doc":{...}}`
  - `DocAlign`      → `{"type":"align","doc":{...}}`
  - `DocReset`      → `{"type":"reset","doc":{...}}`
  - `DocAddCost`    → `{"type":"addCost","doc":{...}}` (cost value is opaque and omitted)
  - `DocTwoColumns` → `{"type":"twoColumns","rows":[{"a":{...},"b":{...}},...] }`
  - `DocBlank`      → `{"type":"blank","width":N}` (internal renderer node)
  - `DocContext`    → `{"type":"context"}` (internal renderer node; function not inspectable)
  - `DocEvaled`     → `{"type":"evaled"}` (internal renderer node; measures not inspectable)

-}
docToJson : P.Doc cost -> String
docToJson doc =
    Json.encode 0 (docToValue doc)


docToValue : P.Doc cost -> Json.Value
docToValue doc =
    when doc is
        P.DocFail ->
            Json.object
                [ { key = "type", value = Json.string "fail" } ]

        P.DocText { string = s, width = w } ->
            Json.object
                [ { key = "type", value = Json.string "text" }
                , { key = "string", value = Json.string s }
                , { key = "width", value = Json.int w }
                ]

        P.DocNewline Nothing ->
            Json.object
                [ { key = "type", value = Json.string "newline" }
                , { key = "flatForm", value = Json.null }
                ]

        P.DocNewline (Just s) ->
            Json.object
                [ { key = "type", value = Json.string "newline" }
                , { key = "flatForm", value = Json.string s }
                ]

        P.DocBlank n ->
            Json.object
                [ { key = "type", value = Json.string "blank" }
                , { key = "width", value = Json.int n }
                ]

        P.DocConcat { a = d1, b = d2 } ->
            Json.object
                [ { key = "type", value = Json.string "concat" }
                , { key = "a", value = docToValue d1 }
                , { key = "b", value = docToValue d2 }
                ]

        P.DocChoice { a = d1, b = d2 } ->
            Json.object
                [ { key = "type", value = Json.string "choice" }
                , { key = "a", value = docToValue d1 }
                , { key = "b", value = docToValue d2 }
                ]

        P.DocNest { indent = n, doc = inner } ->
            Json.object
                [ { key = "type", value = Json.string "nest" }
                , { key = "indent", value = Json.int n }
                , { key = "doc", value = docToValue inner }
                ]

        P.DocAlign inner ->
            Json.object
                [ { key = "type", value = Json.string "align" }
                , { key = "doc", value = docToValue inner }
                ]

        P.DocReset inner ->
            Json.object
                [ { key = "type", value = Json.string "reset" }
                , { key = "doc", value = docToValue inner }
                ]

        P.DocAddCost { cost = _, doc = inner } ->
            Json.object
                [ { key = "type", value = Json.string "addCost" }
                , { key = "doc", value = docToValue inner }
                ]

        P.DocContext _ ->
            Json.object
                [ { key = "type", value = Json.string "context" } ]

        P.DocEvaled _ ->
            Json.object
                [ { key = "type", value = Json.string "evaled" } ]

        P.DocTwoColumns pairs ->
            Json.object
                [ { key = "type", value = Json.string "twoColumns" }
                , { key = "rows", value = Json.array pairToValue pairs }
                ]

        P.DocShared { id, doc = inner, nlCnt } ->
            Json.object
                [ { key = "type", value = Json.string "shared" }
                , { key = "id", value = Json.int id }
                , { key = "nlCnt", value = Json.int nlCnt }
                , { key = "doc", value = docToValue inner }
                ]


pairToValue : P.DocPair cost -> Json.Value
pairToValue { a = d1, b = d2 } =
    Json.object
        [ { key = "a", value = docToValue d1 }
        , { key = "b", value = docToValue d2 }
        ]
