module Main exposing (main)

import Expect
import Test exposing (describe, test)
import Test.Runner.Node exposing (Program, run)

import Constructors
import Costs
import OCamlExamples
import OCamlTests
import ViewItemsTest

main : Program
main =
    run <|
        describe "All Tests"
            [ Constructors.suite
            , Costs.suite
            , OCamlExamples.suite
            , OCamlTests.suite
            , ViewItemsTest.suite
            ]
