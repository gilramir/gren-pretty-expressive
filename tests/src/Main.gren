module Main exposing (main)

import Expect
import Test exposing (describe, test)
import Test.Runner.Node exposing (Program, run)

import Constructors
import Costs
import FlattenDedup
import JsonTest
import NlCntCaching
import OCamlExamples
import OCamlTests
import StackSafety
import TwoColumnsShare
import ViewItemsTest

main : Program
main =
    run <|
        describe "All Tests"
            [ Constructors.suite
            , Costs.suite
            , FlattenDedup.suite
            , JsonTest.suite
            , NlCntCaching.suite
            , OCamlExamples.suite
            , OCamlTests.suite
            , StackSafety.suite
            , TwoColumnsShare.suite
            , ViewItemsTest.suite
            ]
