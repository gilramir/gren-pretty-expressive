module Costs exposing (..)

import Expect exposing (Expectation)
import Test exposing (..)

import PrettyExpressive as P

suite : Test
suite =
    let
        cf80 : P.CostFactory P.DefaultCostTuple
        cf80 =
            P.defaultCostFactory { pageWidth = 80, computationWidth = Nothing }

    in
        describe "Test the choosing of the optimal cost"
            [ test "Reversed order in processConcat" <|
                {- Use "group" to choose between a flattend version and a
                multi-line version. The flattend version is so short that
                it is less costly and should win.
                -}
                \_ ->
                    let
                        -- Join items with breakable zero-width separators.
                        -- Flat:   "( Command (..), parser )"
                        -- Broken: each item on its own line (breakDoc → real newline at indent=4)
                        joinItems : Array (P.Doc cost) -> P.Doc cost
                        joinItems =
                            P.foldDoc (\a b -> P.concat a (P.concat P.breakDoc b))

                        exposingItems : P.Doc cost
                        exposingItems =
                            joinItems
                                [ P.text "( Command(..)"
                                , P.text ", parser"
                                , P.text ")"
                                ]

                        -- group tries flat first; falls back to broken if it overflows.
                        -- nest 4 means all broken newlines (both the leading nl and the
                        -- breakDoc separators between items) land at column 4.
                        exposingList : P.Doc cost
                        exposingList =
                            P.group
                                (P.nest 4
                                    (P.concat P.nl exposingItems)
                                )

                        d = P.concat
                            (P.text "module Terminal.Parser exposing")
                            exposingList

                        expected = """
module Terminal.Parser exposing ( Command(..), parser)
"""

                        maybeActual = P.prettyFormat cf80 d
                    in
                        when maybeActual is
                            Nothing ->
                                Expect.fail "document failed to print"
                            Just actual ->
                                Expect.equal expected actual

            -- ---------------------------------------------------------------
            -- Three-way choice: exercises mergeLists with a 3-element
            -- Pareto-optimal set.
            --
            -- The processConcat bug only required two non-dominating measures
            -- to manifest. mergeLists has never been tested with three.  If it
            -- produced measures in ascending order, prettyFormat would return
            -- the most expensive layout ("a\nb\nc") instead of the cheapest.
            --
            -- Three layouts, all fitting within 80 cols (no overflow cost):
            --   flat:       "aaaa"    -- last=4, cost=(0,0,0)   <- cheapest
            --   two-line:   "aa\nbb"  -- last=2, cost=(0,0,1)
            --   three-line: "a\nb\nc" -- last=1, cost=(0,0,2)   <- most expensive
            --
            -- None dominates any other (wider <-> fewer newlines), so all three
            -- survive into the Pareto set. The printer must return "aaaa".
            , test "Three non-dominating choices: cheapest (widest) is selected" <|
                \_ ->
                    let
                        flatOpt   = P.text "aaaa"
                        twoLine   = P.concat (P.text "aa") (P.concat P.hardNl (P.text "bb"))
                        threeLine = P.vcat [ P.text "a", P.text "b", P.text "c" ]

                        -- choice is left-associative: (flatOpt | twoLine) | threeLine
                        d = P.choice (P.choice flatOpt twoLine) threeLine

                        maybeActual = P.prettyFormat cf80 d
                    in
                        when maybeActual is
                            Nothing ->
                                Expect.fail "document failed to render"
                            Just actual ->
                                Expect.equal "aaaa" actual

            -- ---------------------------------------------------------------
            -- Multiple measures on both sides of concat: exercises foldRight
            -- (2 left measures) together with loop (2 right measures per left).
            --
            -- The existing processConcat test has only ONE left measure, so
            -- foldRight's mergeSets branch has never been reached.  This test
            -- requires it:
            --
            --   left  = group("a" ++ nl ++ "bb")
            --             -> flat   "a bb"  {last=4, cost=(0,0,0)}
            --             -> broken "a\nbb" {last=2, cost=(0,0,1)}  <- 2 left measures
            --
            --   right = group("c" ++ nl ++ "dd")
            --             -> produces 2 non-dominating measures for each left context.
            --
            -- The cheapest overall layout is flat-left ++ flat-right:
            --   "a bbc dd"  cost=(0,0,0)
            --
            -- If foldRight or loop produced ascending output, mergeLists would
            -- receive ascending input (it expects descending) and produce a
            -- garbled result, likely returning "a\nbbc\ndd" or similar.
            , test "Multiple measures on both sides of concat: cheapest combination is selected" <|
                \_ ->
                    let
                        left  = P.group (P.concat (P.text "a")  (P.concat P.nl (P.text "bb")))
                        right = P.group (P.concat (P.text "c")  (P.concat P.nl (P.text "dd")))
                        d     = P.concat left right

                        -- flat left  = "a bb"  (4 chars, zero cost)
                        -- flat right = "c dd"  (4 chars, starting at col 4, zero cost)
                        -- concatenated: "a bbc dd"
                        maybeActual = P.prettyFormat cf80 d
                    in
                        when maybeActual is
                            Nothing ->
                                Expect.fail "document failed to render"
                            Just actual ->
                                Expect.equal "a bbc dd" actual

            ]
